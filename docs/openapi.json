          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "API キー",
              "title": "X-Api-Key"
            },
            "description": "API キー"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressResult"
                }
              }
            }
          },
          "401": {
            "description": "API キーが無効",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "入力値の検証エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/records/normalize": {
      "post": {
        "tags": [
          "records"
        ],
        "summary": "レコードを一括で正規化・名寄せ・重複判定",
        "description": "1 リクエストあたり最大 1000 件。`options.enrich=true` の場合は法人番号 API で名寄せします（サーバーに HOUJIN_APP_ID が設定されていない場合は 503）。",
        "operationId": "post_records_v1_records_normalize_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "API キー",
              "title": "X-Api-Key"
            },
            "description": "API キー"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "401": {
            "description": "API キーが無効",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "入力値の検証エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "件数が上限を超過",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "名寄せ機能が無効",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/corporations/{corporate_number}": {
      "get": {
        "tags": [
          "corporations"
        ],
        "summary": "法人番号から最新の法人情報を取得",
        "operationId": "get_corporation_v1_corporations__corporate_number__get",
        "parameters": [
          {
            "name": "corporate_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{13}$",
              "description": "13 桁の法人番号",
              "title": "Corporate Number"
            },
            "description": "13 桁の法人番号"
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "API キー",
              "title": "X-Api-Key"
            },
            "description": "API キー"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorporationModel"
                }
              }
            }
          },
          "401": {
            "description": "API キーが無効",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "入力値の検証エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "法人番号が不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "該当なし",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "国税庁 API のエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "名寄せ機能が無効",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddressRequest": {
        "properties": {
          "address": {
            "type": "string",
            "maxLength": 1000,
            "title": "Address"
          },
          "postal_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Postal Code"
          }
        },
        "type": "object",
        "required": [
          "address"
        ],
        "title": "AddressRequest",
        "examples": [
          {
            "address": "千代田区霞が関三丁目1番1号",
            "postal_code": "100-8978"
          }
        ]
      },
      "AddressResult": {
        "properties": {
          "original": {
            "type": "string",
            "title": "Original"
          },
          "normalized": {
            "type": "string",
            "title": "Normalized"
          },
          "postal_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postal Code",
            "description": "123-4567 形式"
          },
          "prefecture": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prefecture"
          },
          "prefecture_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prefecture Code",
            "description": "JIS X 0401 都道府県コード"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "town": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Town"
          },
          "block": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Block",
            "description": "番地（1-2-3 形式）"
          },
          "building": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Building"
          },
          "match_key": {
            "type": "string",
            "title": "Match Key"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/IssueModel"
            },
            "type": "array",
            "title": "Issues"
          }
        },
        "type": "object",
        "required": [
          "original",
          "normalized",
          "prefecture",
          "city",
          "town",
          "building",
          "match_key",
          "issues"
        ],
        "title": "AddressResult"
      },
      "BatchOptions": {
        "properties": {
          "enrich": {
            "type": "boolean",
            "title": "Enrich",
            "description": "国税庁 法人番号 API で名寄せする",
            "default": false
          },
          "dedupe": {
            "type": "boolean",
            "title": "Dedupe",
            "description": "リクエスト内の重複を判定する",
            "default": true
          },
          "duplicate_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.5,
            "title": "Duplicate Threshold",
            "default": 0.88
          }
        },
        "type": "object",
        "title": "BatchOptions"
      },
      "BatchRequest": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/RecordIn"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 1,
            "title": "Records"
          },
          "options": {
            "$ref": "#/components/schemas/BatchOptions",
            "default": {
              "enrich": false,
              "dedupe": true,
              "duplicate_threshold": 0.88
            }
          }
        },
        "type": "object",
        "required": [
          "records"
        ],
        "title": "BatchRequest",
        "examples": [
          {
            "options": {
              "dedupe": true,
              "enrich": false
            },
            "records": [
              {
                "address": "大阪市北区梅田1-1-1",
                "id": "C-001",
                "name": "（株）山田商事"
              },
              {
                "address": "大阪府大阪市北区梅田一丁目1番1号",
                "id": "C-002",
                "name": "山田商事株式会社"
              }
            ]
          }
        ]
      },
      "BatchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/RecordResult"
            },
            "type": "array",
            "title": "Results"
          },
          "summary": {
            "$ref": "#/components/schemas/BatchSummary"
          }
        },
        "type": "object",
        "required": [
          "results",
          "summary"
        ],
        "title": "BatchResponse"
      },
      "BatchSummary": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "with_errors": {
            "type": "integer",
            "title": "With Errors"
          },
          "with_warnings": {
            "type": "integer",
            "title": "With Warnings"
          },
          "duplicates": {
            "type": "integer",
            "title": "Duplicates"
          },
          "average_health_score": {
            "type": "number",
            "title": "Average Health Score"
          },
          "enrichment": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Enrichment"
          }
        },
        "type": "object",
        "required": [
          "total",
          "with_errors",
          "with_warnings",
          "duplicates",
          "average_health_score",
          "enrichment"
        ],
        "title": "BatchSummary"
      },
      "CandidateModel": {
        "properties": {
          "corporate_number": {
            "type": "string",
            "title": "Corporate Number"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "score": {
            "type": "number",
            "title": "Score"
