{
  "openapi": "3.1.0",
  "info": {
    "title": "corpnorm API",
    "description": "日本の法人名・住所データを正規化し、国税庁 法人番号公表サイトの情報で名寄せ・補完する API です。\n\n* **法人名**: `(株)` `㈱` `ｶ)` などの表記揺れを統一し、前株／後株を判定\n* **住所**: 漢数字・全角数字・丁目番地号を `1-2-3` 形式に統一、都道府県を補完、郵便番号と照合\n* **名寄せ**: 法人番号 API で正式商号・13 桁の法人番号・最新の本店所在地を特定\n* **品質**: 検出事項コードとデータ健全性スコア、リクエスト内の重複候補を返却\n\n認証: `CORPNORM_API_KEYS` を設定した場合、`X-API-Key` ヘッダーが必須になります。",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "死活監視",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "準備状況",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meta/issue-codes": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "検出事項コードの一覧",
        "operationId": "issue_codes_v1_meta_issue_codes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IssueCodeInfo"
                  },
                  "type": "array",
                  "title": "Response Issue Codes V1 Meta Issue Codes Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/normalize/name": {
      "post": {
        "tags": [
          "normalize"
        ],
        "summary": "法人名を正規化",
        "operationId": "post_name_v1_normalize_name_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "API キー",
              "title": "X-Api-Key"
            },
            "description": "API キー"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NameRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NameResult"
                }
              }
            }
          },
          "401": {
            "description": "API キーが無効",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "入力値の検証エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/normalize/address": {
