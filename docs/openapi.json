              }
            ],
            "title": "Kind"
          },
          "kind_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind Label"
          },
          "furigana": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Furigana"
          },
          "en_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "En Name"
          },
          "prefecture_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prefecture Name"
          },
          "city_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City Name"
          },
          "street_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Street Number"
          },
          "address": {
            "type": "string",
            "title": "Address",
            "description": "本店所在地"
          },
          "post_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
